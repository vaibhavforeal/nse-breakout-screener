{
  "name": "nse-breakout-screener",
  "version": "2.3.0",
  "description": "Automated NSE breakout screener with 12 signals, market context gate, and trade plan calculator",
  "type": "module",
  "main": "screener.mjs",
  "scripts": {
    "start": "node screener.mjs",
    "scan": "node screener.mjs",
    "scan:fast": "node screener.mjs --no-oi",
    "scan:nifty50": "node screener.mjs --index \"NIFTY 50\"",
    "scan:nifty50:fast": "node screener.mjs --index \"NIFTY 50\" --no-oi",
    "scan:nifty500": "node screener.mjs --index \"NIFTY 500\"",
    "scan:midcap": "node screener.mjs --index \"NIFTY MIDCAP 150\"",
    "scan:smallcap": "node screener.mjs --index \"NIFTY SMALLCAP 250\"",
    "dashboard": "node server.mjs"
  },
  "dependencies": {
    "stock-nse-india": "^1.3.0",
    "technicalindicators": "^3.1.0"
  }
}
